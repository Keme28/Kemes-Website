# ==============================================================================
# UKEME PORTFOLIO ENVIRONMENT VARIABLES
# ==============================================================================
#
# IMPORTANT SECURITY NOTICE:
# - NEVER put secret tokens, API keys, or private webhook URLs in variables prefixed with VITE_.
# - Variables starting with VITE_ are bundled into public client-side JavaScript and can be inspected
#   by anyone opening DevTools in their browser.
# - Server-side secrets (N8N_WEBHOOK_URL, N8N_WEBHOOK_SECRET, TURNSTILE_SECRET_KEY) must ONLY be
#   defined without the VITE_ prefix. They are accessible strictly inside serverless functions (/api/contact).
#
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC CLIENT-SIDE VARIABLES (Exposed to Browser)
# ------------------------------------------------------------------------------
# Public canonical domain URL
VITE_SITE_URL=https://ukeme.dev

# Cloudflare Turnstile Public Site Key
# Cloudflare official testing site key (always succeeds in dev): 1x00000000000000000000AA
# Replace with your real Turnstile Site Key from Cloudflare Dashboard in production:
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Public contact identifiers
VITE_WEBSITE_EMAIL=ukemeobonguduak@gmail.com
VITE_TARGET_EMAIL=kemeumoudofia@gmail.com

# Google Drive Automation Videos Folder Link ("Watch me automate" section)
VITE_GOOGLE_DRIVE_URL=https://drive.google.com/drive/folders/YOUR_GOOGLE_DRIVE_FOLDER_ID

# ------------------------------------------------------------------------------
# 2. PRIVATE SERVER-SIDE SECRETS (SERVERLESS FUNCTIONS ONLY — NEVER USE VITE_ PREFIX!)
# ------------------------------------------------------------------------------
# Target n8n automation webhook URL where verified intake payloads are forwarded.
# E.g. https://n8n.yourdomain.com/webhook/portfolio-intake
N8N_WEBHOOK_URL=https://n8n.yourdomain.com/webhook/portfolio-intake

# Secret token transmitted in the 'x-webhook-secret' header for n8n payload validation
N8N_WEBHOOK_SECRET=your_super_secret_n8n_webhook_header_token

# Cloudflare Turnstile Secret Key used by serverless /api/contact to verify visitor tokens
# Cloudflare official testing secret key (always succeeds in dev): 1x0000000000000000000000000000000AA
# Replace with your real Turnstile Secret Key from Cloudflare Dashboard in production:
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# CORS Allowed Origin for Serverless Functions (restricts cross-origin invocation)
ALLOWED_ORIGIN=https://ukeme.dev
